# ---- MongoDB ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=braillepay

# ---- JWT ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed origins, e.g. https://your-frontend.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# ---- WebAuthn ----
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BraillePay
WEBAUTHN_ORIGINS=http://localhost:5500

# ---- Demo / Deployment ----
DEMO_MODE=true
PORT=8000

# ---- Security tuning ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
