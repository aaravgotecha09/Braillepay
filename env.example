# Copy to backend/.env for local development. NEVER commit a filled-in .env.
# Every value below is a placeholder. Real secrets belong in the host's environment
# settings (Render dashboard), not in this file or in source control.

# ---- MongoDB ----
# Local: mongodb://localhost:27017   Atlas: paste the connection string into Render, not here.
MONGO_URL=mongodb://localhost:27017
DB_NAME=braillepay

# ---- JWT ----
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

# ---- CORS ----
# Comma-separated, exact origins (scheme + host + optional port, no trailing slash).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- WebAuthn ----
# RP_ID is the bare domain (no scheme, no port). ORIGINS must match the page origin exactly.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=BraillePay
WEBAUTHN_ORIGINS=http://localhost:5500

# ---- Demo / Deployment ----
# DEMO_MODE exposes demo users, /api/demo/reset and /api/demo/stats (authenticated).
DEMO_MODE=true
PORT=8000

# ---- Security tuning ----
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ---- Razorpay (test-mode merchant checkout; OFF by default) ----
# Keys come from the Razorpay Dashboard. Use TEST keys only (rzp_test_...).
# Live mode is refused by the code unless RAZORPAY_MODE=live, RAZORPAY_LIVE_APPROVED=true
# and the key id starts with rzp_live_. Do not enable live mode without explicit approval.
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_LIVE_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
